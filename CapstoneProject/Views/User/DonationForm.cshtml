@model CapstoneProject.Models.ScheduledDonation

@{
    ViewData["Title"] = "Schedule a Donation";
}

<style>
    .donation-page {
        max-width: 950px;
        margin: 30px auto;
        background: white;
        padding: 35px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.12);
        border-top: 8px solid #349444;
    }

    .scc-blue {
        color: #242c5c;
    }

    .scc-green {
        color: #349444;
    }

    .btn-scc {
        background-color: #242c5c;
        border-color: #242c5c;
        color: white;
        padding: 12px;
        font-weight: bold;
    }

        .btn-scc:hover {
            background-color: #349444;
            border-color: #349444;
            color: white;
        }
</style>

<div class="donation-page">
    <div class="text-center mb-4">
        <img src="/Images/logo.png" alt="Chaser Logo" style="max-width: 250px;" />
        <h1 class="mt-3 scc-blue">Schedule a <span class="scc-green">Donation</span></h1>
        <p class="text-muted">
            Use this form to schedule a time to bring in a donation. Staff will officially log the donation after it is received.
        </p>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <form asp-action="DonationForm" asp-controller="User" method="post">
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Company" class="form-label">Company / Organization Name</label>
            <input asp-for="Company" class="form-control" placeholder="Optional" />
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ScheduledDropOffTime" class="form-label"></label>
            <input asp-for="ScheduledDropOffTime"
                   type="datetime-local"
                   class="form-control"
                   value="@(Model.ScheduledDropOffTime == default ? "" : Model.ScheduledDropOffTime.ToString("yyyy-MM-ddTHH:mm"))"
                   required />
            <span asp-validation-for="ScheduledDropOffTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DonationDescription" class="form-label">Donation Description</label>
            <textarea asp-for="DonationDescription" class="form-control" rows="4"
                      placeholder="Example: canned goods, snacks, hygiene items, drinks, etc." required></textarea>
        </div>

        <div class="mb-4">
            <label asp-for="Notes" class="form-label">Extra Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"
                      placeholder="Any extra details staff should know"></textarea>
        </div>

        <button type="submit" class="btn btn-scc w-100">Submit Donation Request</button>
    </form>
</div>
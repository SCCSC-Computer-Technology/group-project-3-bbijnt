@model CapstoneProject.Models.ResetPasswordcs

@{
    ViewData["Title"] = "Reset Password";
}

<div class="min-h-screen bg-image-custom flex items-center justify-center p-4">
    <div class="bg-gray-50 shadow-2xl rounded-xl max-w-md w-full p-8">

        <div class="text-center mb-6">
            <div class="inline-block p-4 bg-[#005596] rounded-full border border-gray-300">
                <img src="~/Images/SCC-logo.png" alt="Spartanburg Community College Logo" class="h-10 mx-auto" />
            </div>
        </div>

        <h2 class="text-xl font-semibold text-gray-800 text-center">Reset Password</h2>
        <p class="text-sm text-gray-600 text-center mt-2">
            Create a new password for your account.
        </p>

        <hr class="border-gray-300 my-6" />

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="bg-red-100 text-red-700 text-sm p-3 rounded-md mb-4">
                @ViewBag.ErrorMessage
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="Login" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <input asp-for="UserID" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="relative">
                <input asp-for="NewPassword"
                       type="password"
                       class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Enter new password" />

                <label asp-for="NewPassword"
                       class="absolute -top-2 left-3 bg-gray-50 px-1 text-sm text-gray-600">
                    New Password
                </label>

                <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
            </div>

            <div class="relative">
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Confirm new password" />

                <label asp-for="ConfirmPassword"
                       class="absolute -top-2 left-3 bg-gray-50 px-1 text-sm text-gray-600">
                    Confirm Password
                </label>

                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-3 rounded-md hover:bg-blue-700 transition duration-200">
                Reset Password
            </button>

            <div class="text-center">
                <a asp-area="Identity" asp-page="/Account/Login" class="text-blue-600 hover:underline text-sm">
                    Back to Login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.tailwindcss.com"></script>
}
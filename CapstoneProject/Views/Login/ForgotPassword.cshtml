@model CapstoneProject.Models.ForgotPasswordcs

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen bg-image-custom flex items-center justify-center p-4">
    <div class="bg-gray-50 shadow-2xl rounded-xl max-w-md w-full p-8 border-5 border-primary rounded">

        <div class="text-center mb-6">
            <div class="inline-block p-4 bg-[#005596] rounded-full border border-gray-300">
                <img src="~/Images/SCC-logo.png" alt="Spartanburg Community College Logo" class="h-10 mx-auto" />
            </div>
        </div>

        <h2 class="text-xl font-semibold text-gray-800 text-center">Forgot Password</h2>
        <p class="text-sm text-gray-600 text-center mt-2">
            Enter your SCC ID and email to reset your password.
        </p>

        <hr class="border-gray-300 my-6" />

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="bg-red-100 text-red-700 text-sm p-3 rounded-md mb-4">
                @ViewBag.ErrorMessage
            </div>
        }

        <form asp-action="ForgotPassword" asp-controller="Login" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div class="relative">
                <input asp-for="UserID"
                       class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="0214365"
                       maxlength="7" />

                <label asp-for="UserID"
                       class="absolute -top-2 left-3 bg-gray-50 px-1 text-sm text-gray-600">
                    User ID
                </label>

                <span asp-validation-for="UserID" class="text-red-500 text-sm"></span>
            </div>

            <div class="relative">
                <input asp-for="Email"
                       class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Enter your email" />

                <label asp-for="Email"
                       class="absolute -top-2 left-3 bg-gray-50 px-1 text-sm text-gray-600">
                    Email
                </label>

                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-3 rounded-md hover:bg-blue-700 transition duration-200">
                Continue
            </button>

            <div class="text-center">
                <a asp-area="Identity" asp-page="/Account/Login" class="text-blue-600 hover:underline text-sm">
                    Back to Login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.tailwindcss.com"></script>
}
@model List<CapstoneProject.Models.ScheduledDonation>

@{
    ViewData["Title"] = "Scheduled Donations";
}

<style>
    .scheduled-page {
        max-width: 1100px;
        margin: 30px auto;
        background: white;
        padding: 35px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.12);
        border-top: 8px solid #349444;
    }

    .scc-blue {
        color: #242c5c;
    }

    .scc-green {
        color: #349444;
    }

    .btn-scc {
        background-color: #242c5c;
        border-color: #242c5c;
        color: white;
        font-weight: bold;
    }

    .btn-scc:hover {
        background-color: #349444;
        border-color: #349444;
        color: white;
    }

    .badge-pending {
        background-color: #ffc107;
        color: black;
    }

    .badge-completed {
        background-color: #349444;
        color: white;
    }
</style>

<div class="scheduled-page">
    <div class="text-center mb-4">
        <img src="/Images/logo.png" alt="Chaser Logo" style="max-width: 220px;" />
        <h1 class="mt-3 scc-blue">Scheduled <span class="scc-green">Donations</span></h1>
        <p class="text-muted">
            View donation drop-offs submitted by users.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No scheduled donations have been submitted yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead style="background-color:#242c5c; color:white;">
                <tr>
                    <th>Status</th>
                    <th>Drop-Off Time</th>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Description</th>
                    <th>Notes</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var donation in Model)
                {
                    <tr>
                        <td>
                            @if (donation.IsCompleted)
                            {
                                <span class="badge badge-completed">Completed</span>
                            }
                            else
                            {
                                <span class="badge badge-pending">Pending</span>
                            }
                        </td>

                        <td>@donation.ScheduledDropOffTime.ToString("MM/dd/yyyy hh:mm tt")</td>
                        <td>@donation.FirstName @donation.LastName</td>
                        <td>@(string.IsNullOrWhiteSpace(donation.Company) ? "N/A" : donation.Company)</td>
                        <td>@donation.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(donation.Phone) ? "N/A" : donation.Phone)</td>
                        <td>@donation.DonationDescription</td>
                        <td>@(string.IsNullOrWhiteSpace(donation.Notes) ? "N/A" : donation.Notes)</td>

                        <td>
                            @if (!donation.IsCompleted)
                            {
                                <form asp-controller="Staff" asp-action="CompleteScheduledDonation" method="post">
                                    <input type="hidden" name="id" value="@donation.ScheduledDonationID" />
                                    <button type="submit" class="btn btn-scc btn-sm">
                                        Mark Completed
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Done</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
